---
import Layout from "../layouts/Layout.astro"
---

<Layout title="Home of the Warriors">
  <main class="flex-grow flex flex-col items-center justify-center text-center px-4 py-20">
    <div class="max-w-3xl border border-brandGold bg-black/40 p-8 rounded-lg shadow-2xl backdrop-blur-md">
      <span class="text-brandGold font-display font-bold text-sm tracking-widest uppercase block mb-2">
        Established 2005
      </span>
      <h1 class="text-4xl md:text-6xl font-display font-extrabold text-brandGold tracking-tight uppercase mb-4">
        Battlefield Muay Thai Gym
      </h1>
      <p class="text-lg md:text-xl text-brandOffWhite font-sans font-normal max-w-2xl mx-auto mb-8">
        Experience premium martial arts coaching under world-class instructors in Hornchurch.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="tel:07980775228" class="bg-brandGold text-brandBlack hover:bg-brandGoldDark font-sans font-bold px-8 py-3 rounded uppercase transition-all duration-200">
          Contact Dee: 07980 775 228
        </a>
        <a href="tel:07562980333" class="border border-brandGold text-brandGold hover:bg-brandGold hover:text-brandBlack font-sans font-bold px-8 py-3 rounded uppercase transition-all duration-200">
          Contact Grant: 07562 980 333
        </a>
      </div>
    </div>
  </main>
</Layout>
