---
import Layout from "../layouts/Layout.astro"
import Header from "../components/Header.astro"
import Timetable from "../components/Timetable.astro"
import ContactForm from "../components/ContactForm.astro"

// Instructor Carousel Imports
import grantImg from "../assets/fighters/image_72.jpg"
import deeImg from "../assets/fighters/image_73.jpg"
import lucieImg from "../assets/fighters/image_11.png"
import chloeImg from "../assets/fighters/image_12.png"

// Gallery Previews
import gallery1 from "../assets/gallery/image_16.jpg"
import gallery2 from "../assets/gallery/image_31.jpg"
import gallery3 from "../assets/gallery/image_20.jpg"
import gallery4 from "../assets/gallery/image_68.png"
import gallery5 from "../assets/gallery/image_24.jpg"
import gallery6 from "../assets/gallery/image_76.png"

// Sponsors Grid
import sponsor1 from "../assets/sponsors/image_35.png"
import sponsor2 from "../assets/sponsors/image_64.jpg"
import sponsor3 from "../assets/sponsors/image_65.jpg"
import sponsor4 from "../assets/sponsors/image_66.png"
import sponsor5 from "../assets/sponsors/image_67.jpg"
---

<Layout title="Home of the Warriors">
  <Header />

  <main class="flex-grow w-full max-w-7xl mx-auto px-4 py-16">
    <section class="text-center mb-16 py-12 border-b border-brandGold/20">
      <span class="text-brandGold font-display font-bold text-sm tracking-widest uppercase block mb-2">
        Hornchurch Essex
      </span>
      <h1 class="text-4xl md:text-6xl font-display font-extrabold text-brandGold tracking-tight uppercase mb-4">
        Battlefield Muay Thai Gym
      </h1>
      <p class="text-lg md:text-xl text-brandOffWhite font-sans font-normal max-w-2xl mx-auto mb-8">
        Learn professional martial arts and elite physical conditioning under world-class coaches.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="#contact" class="bg-brandGold text-brandBlack hover:bg-brandGoldDark font-sans font-bold px-8 py-3 rounded uppercase transition-all duration-200">
          Book Free Trial
        </a>
        <a href="#timetable" class="border border-brandGold text-brandGold hover:bg-brandGold hover:text-brandBlack font-sans font-bold px-8 py-3 rounded uppercase transition-all duration-200">
          View Timetable
        </a>
      </div>
    </section>

    <section class="mb-20 relative px-4">
      <div class="text-center mb-10">
        <span class="text-brandGold font-display font-bold text-xs tracking-widest uppercase block mb-2">
          Expert Leadership
        </span>
        <h2 class="text-3xl font-display font-extrabold text-brandOffWhite uppercase tracking-tight">
          Our Instructors
        </h2>
        <div class="w-24 h-1 bg-brandGold mx-auto mt-4"></div>
      </div>

      <div class="relative max-w-5xl mx-auto">
        <div id="instructor-carousel" class="flex gap-6 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-6 carousel-container">
          
          <div class="min-w-full sm:min-w-[50%] md:min-w-[33.333%] snap-start border border-brandGold/20 bg-black/40 rounded-lg overflow-hidden group">
            <div class="relative aspect-[3/4] bg-neutral-900 overflow-hidden">
              <img src={grantImg.src} alt="Sifu Grant Guirey" class="w-full h-full object-cover group-hover:scale-105 transition-all duration-500" loading="lazy" />
              <div class="absolute inset-0 bg-gradient-to-t from-brandBlack via-transparent to-transparent"></div>
            </div>
            <div class="p-6">
              <span class="text-brandGold font-display font-bold text-xs tracking-widest uppercase block mb-1">Chief Instructor</span>
              <h3 class="text-xl font-display font-extrabold text-brandOffWhite uppercase mb-2">Sifu Grant Guirey</h3>
              <p class="text-sm text-brandGray font-sans">Founder and technical mastermind behind the BMTG competitive curriculum.</p>
            </div>
          </div>

          <div class="min-w-full sm:min-w-[50%] md:min-w-[33.333%] snap-start border border-brandGold/20 bg-black/40 rounded-lg overflow-hidden group">
            <div class="relative aspect-[3/4] bg-neutral-900 overflow-hidden">
              <img src={deeImg.src} alt="Dee Guirey" class="w-full h-full object-cover group-hover:scale-105 transition-all duration-500" loading="lazy" />
              <div class="absolute inset-0 bg-gradient-to-t from-brandBlack via-transparent to-transparent"></div>
            </div>
            <div class="p-6">
              <span class="text-brandGold font-display font-bold text-xs tracking-widest uppercase block mb-1">Instructor & Coordinator</span>
              <h3 class="text-xl font-display font-extrabold text-brandOffWhite uppercase mb-2">Dee Guirey</h3>
              <p class="text-sm text-brandGray font-sans">Leads community outreach programmes, gym membership tracks, and junior class schedules.</p>
            </div>
          </div>

          <div class="min-w-full sm:min-w-[50%] md:min-w-[33.333%] snap-start border border-brandGold/20 bg-black/40 rounded-lg overflow-hidden group">
            <div class="relative aspect-[3/4] bg-neutral-900 overflow-hidden">
              <img src={lucieImg.src} alt="Lucie Guirey" class="w-full h-full object-cover group-hover:scale-105 transition-all duration-500" loading="lazy" />
              <div class="absolute inset-0 bg-gradient-to-t from-brandBlack via-transparent to-transparent"></div>
            </div>
            <div class="p-6">
              <span class="text-brandGold font-display font-bold text-xs tracking-widest uppercase block mb-1">Elite Team Coach</span>
              <h3 class="text-xl font-display font-extrabold text-brandOffWhite uppercase mb-2">Lucie Guirey</h3>
              <p class="text-sm text-brandGray font-sans">Active world class champion delivering professional performance and sparring insight.</p>
            </div>
          </div>

          <div class="min-w-full sm:min-w-[50%] md:min-w-[33.333%] snap-start border border-brandGold/20 bg-black/40 rounded-lg overflow-hidden group">
            <div class="relative aspect-[3/4] bg-neutral-900 overflow-hidden">
              <img src={chloeImg.src} alt="Chloe Guirey" class="w-full h-full object-cover group-hover:scale-105 transition-all duration-500" loading="lazy" />
              <div class="absolute inset-0 bg-gradient-to-t from-brandBlack via-transparent to-transparent"></div>
            </div>
            <div class="p-6">
              <span class="text-brandGold font-display font-bold text-xs tracking-widest uppercase block mb-1">Technical Instructor</span>
              <h3 class="text-xl font-display font-extrabold text-brandOffWhite uppercase mb-2">Chloe Guirey</h3>
              <p class="text-sm text-brandGray font-sans">Specialises in fundamental skill acquisition, movement patterns, and youth progression paths.</p>
            </div>
          </div>

        </div>

        <button id="prev-slide" class="absolute left-[-20px] top-[40%] -translate-y-1/2 bg-brandBlack/80 border border-brandGold text-brandGold w-10 h-10 rounded-full flex items-center justify-center hover:bg-brandGold hover:text-brandBlack transition-all duration-200 z-10" aria-label="Previous Slide">
          &larr;
        </button>
        <button id="next-slide" class="absolute right-[-20px] top-[40%] -translate-y-1/2 bg-brandBlack/80 border border-brandGold text-brandGold w-10 h-10 rounded-full flex items-center justify-center hover:bg-brandGold hover:text-brandBlack transition-all duration-200 z-10" aria-label="Next Slide">
          &rarr;
        </button>
      </div>
    </section>

    <section class="mb-16 pt-8 border-t border-brandGold/20">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-display font-extrabold text-brandOffWhite uppercase tracking-tight">
          Inside The Facility
        </h2>
        <div class="w-24 h-1 bg-brandGold mx-auto mt-4"></div>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4 max-w-5xl mx-auto mb-8">
        <img src={gallery1.src} alt="Adult Muay Thai Training" class="w-full h-48 md:h-64 object-cover rounded border border-brandGold/20 hover:border-brandGold transition-colors duration-300" loading="lazy" />
        <img src={gallery2.src} alt="Ladies Programme" class="w-full h-48 md:h-64 object-cover rounded border border-brandGold/20 hover:border-brandGold transition-colors duration-300" loading="lazy" />
        <img src={gallery3.src} alt="Kids Martial Arts" class="w-full h-48 md:h-64 object-cover rounded border border-brandGold/20 hover:border-brandGold transition-colors duration-300" loading="lazy" />
        <img src={gallery4.src} alt="Gym Facility Equipment" class="w-full h-48 md:h-64 object-cover rounded border border-brandGold/20 hover:border-brandGold transition-colors duration-300" loading="lazy" />
        <img src={gallery5.src} alt="Advanced Conditioning" class="w-full h-48 md:h-64 object-cover rounded border border-brandGold/20 hover:border-brandGold transition-colors duration-300" loading="lazy" />
        <img src={gallery6.src} alt="Juniors Technique Drills" class="w-full h-48 md:h-64 object-cover rounded border border-brandGold/20 hover:border-brandGold transition-colors duration-300" loading="lazy" />
      </div>
      <div class="text-center">
        <a href="/gallery" class="inline-block border border-brandGold text-brandGold hover:bg-brandGold hover:text-brandBlack font-sans font-bold px-8 py-3 rounded uppercase transition-all duration-200">
          View Full Gallery
        </a>
      </div>
    </section>

    <Timetable />

    <section id="about" class="w-full py-16 mt-16 border-t border-brandGold/20 bg-brandBlack">
      <div class="max-w-4xl mx-auto px-4 text-center">
        <span class="text-brandGold font-display font-bold text-xs tracking-widest uppercase block mb-2">
          Our Legacy
        </span>
        <h2 class="text-3xl md:text-4xl font-display font-extrabold text-brandOffWhite uppercase tracking-tight mb-6">
          About Battlefield Muay Thai Gym
        </h2>
        <div class="w-24 h-1 bg-brandGold mx-auto mb-8"></div>
        <p class="text-lg text-brandGray font-sans leading-relaxed mb-6">
          Established in 2005, Battlefield Muay Thai Gym is one of the premier training facilities in Essex. We cover Hornchurch, Elm Park, Upminster, and Romford. Our elite instructors focus on building confidence through competence by offering the best fitness and self defence methods available.
        </p>
        <p class="text-lg text-brandGray font-sans leading-relaxed">
          Whether you are a complete beginner looking to get fit or an aspiring professional aiming for the boxing ring, we guide you through the process of physical and mental self development. Our goal is to ensure you have the capability to become a champion in life.
        </p>
      </div>
    </section>

    <section id="location" class="w-full py-16 border-t border-brandGold/20 bg-neutral-950">
      <div class="max-w-6xl mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          
          <div class="space-y-6">
            <span class="text-brandGold font-display font-bold text-xs tracking-widest uppercase block">
              Find the Gym
            </span>
            <h2 class="text-3xl md:text-4xl font-display font-extrabold text-brandOffWhite uppercase tracking-tight">
              Location & Directions
            </h2>
            <div class="w-24 h-1 bg-brandGold"></div>
            
            <p class="text-brandGray font-sans text-base leading-relaxed">
              Battlefield Muay Thai Gym is located in the heart of Hornchurch. Our elite training facility features a full-sized boxing ring, professional heavy bag stations, and comprehensive technical equipment.
            </p>
            
            <div class="bg-brandBlack border border-brandGold/20 p-6 rounded-lg space-y-4">
              <div class="flex items-start gap-4">
                <div class="text-brandGold mt-1">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                </div>
                <div>
                  <h4 class="font-display font-bold text-sm uppercase text-brandOffWhite tracking-wider">Physical Address</h4>
                  <p class="text-brandGray font-sans text-sm mt-1">
                    Unit 6 rear of, 177-181 Hornchurch Road, Hornchurch, Essex, RM12 4TE
                  </p>
                </div>
              </div>
              
              <div class="flex items-start gap-4 border-t border-brandGold/10 pt-4">
                <div class="text-brandGold mt-1">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                  </svg>
                </div>
                <div>
                  <h4 class="font-display font-bold text-sm uppercase text-brandGold tracking-wider">Important Access Notice</h4>
                  <p class="text-brandOffWhite font-sans font-semibold text-sm mt-1">
                    Entrance is via Vicarage Road
                  </p>
                </div>
              </div>
            </div>
            
            <div class="flex flex-col sm:flex-row gap-4 pt-2">
              <a href="https://www.google.com/maps/dir/?api=1&destination=51.562141,0.205735" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 bg-neutral-900 hover:bg-neutral-800 border border-brandGold/30 text-brandOffWhite font-sans font-bold text-sm uppercase tracking-wider px-6 py-3.5 rounded transition-all duration-200">
                Directions in Google Maps
              </a>
              <a href="maps://maps.apple.com/?daddr=51.562141,0.205735" class="flex items-center justify-center gap-2 bg-neutral-900 hover:bg-neutral-800 border border-brandGold/30 text-brandOffWhite font-sans font-bold text-sm uppercase tracking-wider px-6 py-3.5 rounded transition-all duration-200">
                Directions in Apple Maps
              </a>
            </div>
          </div>
          
          <div class="relative w-full aspect-square md:aspect-[4/3] lg:aspect-square bg-neutral-900 border border-brandGold/30 rounded-lg overflow-hidden group shadow-2xl">
            <div class="absolute inset-0 opacity-40 bg-[radial-gradient(#D4AF37_1px,transparent_1px)] [background-size:16px_16px] bg-brandBlack"></div>
            <svg class="absolute inset-0 w-full h-full text-brandGold/10" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M -100,200 L 800,200" />
              <path d="M -100,450 L 800,450" />
              <path d="M 300,-100 L 300,800" />
              <path d="M 500,-100 L 500,800" stroke-width="3" class="text-brandGold/20" />
              <path d="M 300,450 Q 380,380 500,380" stroke-width="2" class="text-brandGold/20" />
            </svg>
            <div class="absolute top-[34%] right-[4%] bg-black/80 border border-brandGold/20 px-3 py-1.5 rounded text-[10px] tracking-widest font-display font-bold uppercase text-brandGold">
              Hornchurch Road (A124)
            </div>
            <div class="absolute bottom-[36%] left-[32%] bg-black/80 border border-brandGold/20 px-3 py-1.5 rounded text-[10px] tracking-widest font-display font-bold uppercase text-brandOffWhite">
              Vicarage Road
            </div>
            <div class="absolute top-[48%] left-[48%] -translate-x-1/2 -translate-y-1/2 flex items-center justify-center">
              <span class="absolute inline-flex h-16 w-16 rounded-full bg-brandGold/20 animate-ping opacity-75"></span>
              <span class="absolute inline-flex h-8 w-8 rounded-full bg-brandGold/40 animate-pulse"></span>
              <div class="relative bg-brandBlack border-2 border-brandGold p-3 rounded-full shadow-lg group-hover:scale-110 transition-transform duration-300">
                <svg class="w-8 h-8 text-brandGold" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M50 5 L90 25 L90 55 C90 75 50 95 50 95 C50 95 10 75 10 55 L10 25 Z" fill="black" stroke="#D4AF37" stroke-width="4"/>
                  <path d="M35 40 Q50 20 65 40 Q50 60 35 40 Z" fill="#D4AF37"/>
                </svg>
              </div>
            </div>
            <div class="absolute bottom-4 right-4 bg-brandBlack/90 border border-brandGold/20 px-4 py-2 rounded text-[11px] font-sans text-brandGray">
              GPS: <span class="text-brandOffWhite font-semibold">51.5621° N, 0.2057° E</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="w-full py-12 border-t border-brandGold/20 bg-brandBlack">
      <div class="max-w-6xl mx-auto px-4">
        <div class="text-center mb-10">
          <h2 class="text-2xl font-display font-extrabold text-brandOffWhite uppercase tracking-tight">
            Proudly Supported By
          </h2>
          <div class="w-16 h-1 bg-brandGold mx-auto mt-4"></div>
        </div>
        <div class="flex flex-wrap justify-center items-center gap-8 md:gap-16 max-w-4xl mx-auto opacity-70 grayscale hover:grayscale-0 transition-all duration-500">
          <img src={sponsor1.src} alt="Delaney's" class="h-12 md:h-16 object-contain" loading="lazy" />
          <img src={sponsor2.src} alt="Hamton Environmental Services" class="h-12 md:h-16 object-contain" loading="lazy" />
          <img src={sponsor3.src} alt="Roof Care Company" class="h-12 md:h-16 object-contain" loading="lazy" />
          <img src={sponsor4.src} alt="MJ Bushell Chartered Accountants" class="h-12 md:h-16 object-contain" loading="lazy" />
          <img src={sponsor5.src} alt="A3E Local Partner" class="h-12 md:h-16 object-contain" loading="lazy" />
        </div>
      </div>
    </section>

    <ContactForm />
  </main>
</Layout>

<script>
  const carousel = document.getElementById("instructor-carousel")
  const prevBtn = document.getElementById("prev-slide")
  const nextBtn = document.getElementById("next-slide")

  if (carousel && prevBtn && nextBtn) {
    prevBtn.addEventListener("click", () => {
      const cardWidth = carousel.firstElementChild ? (carousel.firstElementChild as HTMLElement).offsetWidth + 24 : 300
      carousel.scrollBy({ left: -cardWidth, behavior: "smooth" })
    })

    nextBtn.addEventListener("click", () => {
      const cardWidth = carousel.firstElementChild ? (carousel.firstElementChild as HTMLElement).offsetWidth + 24 : 300
      carousel.scrollBy({ left: cardWidth, behavior: "smooth" })
    })
  }
</script>
