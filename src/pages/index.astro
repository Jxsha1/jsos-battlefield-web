---
import Layout from "../layouts/Layout.astro"
import Header from "../components/Header.astro"
import FighterCard from "../components/FighterCard.astro"
import ContactForm from "../components/ContactForm.astro"
---

<Layout title="Home of the Warriors">
  <!-- Brand New Responsive Navigation Header -->
  <Header />

  <main class="flex-grow w-full max-w-7xl mx-auto px-4 py-16">
    <!-- Hero Banner Section -->
    <section class="text-center mb-16 py-12 border-b border-brandGold/20">
      <span class="text-brandGold font-display font-bold text-sm tracking-widest uppercase block mb-2">
        Hornchurch Essex
      </span>
      <h1 class="text-4xl md:text-6xl font-display font-extrabold text-brandGold tracking-tight uppercase mb-4">
        Battlefield Muay Thai Gym
      </h1>
      <p class="text-lg md:text-xl text-brandOffWhite font-sans font-normal max-w-2xl mx-auto mb-8">
        Learn professional martial arts and elite physical conditioning under world-class coaches.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="#contact" class="bg-brandGold text-brandBlack hover:bg-brandGoldDark font-sans font-bold px-8 py-3 rounded uppercase transition-all duration-200">
          Book Free Trial
        </a>
        <a href="tel:07980775228" class="border border-brandGold text-brandGold hover:bg-brandGold hover:text-brandBlack font-sans font-bold px-8 py-3 rounded uppercase transition-all duration-200">
          Call: 07980 775 228
        </a>
      </div>
    </section>

    <!-- Champions Showcase Grid -->
    <section class="mb-16">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-display font-extrabold text-brandOffWhite uppercase tracking-tight">
          Our World Class Champions
        </h2>
        <div class="w-24 h-1 bg-brandGold mx-auto mt-4"></div>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <FighterCard 
          name="Lucie Guirey"
          title="World Champion"
          achievement="Elite standard competitor representing BMTG on global professional fight cards."
          imageRemoteUrl="https://images.unsplash.com/photo-1517838277536-f5f99be501cd?q=80&w=600&auto=format&fit=crop"
        />
        <FighterCard 
          name="Chloe Guirey"
          title="Champion Instructor"
          achievement="Certified technical martial arts coach specializing in fighter development paths."
          imageRemoteUrl="https://images.unsplash.com/photo-1549719386-74dfcbf7dbed?q=80&w=600&auto=format&fit=crop"
        />
      </div>
    </section>

    <!-- Fully Functional Secure Contact and Registration Form -->
    <ContactForm />
  </main>
</Layout>
