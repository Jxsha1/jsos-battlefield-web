---
import Layout from "../layouts/Layout.astro"
---

<Layout title="Home of the Warriors">
  <main class="flex-grow flex flex-col items-center justify-center text-center px-4 py-20">
    <div class="max-w-3xl border border-[#D4AF37] bg-black/50 p-8 rounded-lg shadow-xl backdrop-blur-sm">
      <h1 class="text-4xl md:text-6xl font-sans font-bold text-[#D4AF37] tracking-tight uppercase mb-4">
        Battlefield Muay Thai Gym
      </h1>
      <p class="text-xl md:text-2xl text-[#F5F5F5] font-light max-w-2xl mx-auto mb-8">
        Bespoke secure digital presence prototype built by JS Office Solutions.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="tel:07980775228" class="bg-[#D4AF37] text-[#0B0B0B] hover:bg-[#C5A028] font-bold px-8 py-3 rounded uppercase transition-all duration-200">
          Call Dee: 07980 775 228
        </a>
        <a href="tel:07562980333" class="border border-[#D4AF37] text-[#D4AF37] hover:bg-[#D4AF37] hover:text-[#0B0B0B] font-bold px-8 py-3 rounded uppercase transition-all duration-200">
          Call Grant: 07562 980 333
        </a>
      </div>
    </div>
  </main>
</Layout>
