---
import Layout from "../layouts/Layout.astro"
import Header from "../components/Header.astro"

const assetFiles = import.meta.glob("../assets/image_*.{png,jpg,jpeg,svg}", { eager: true })

const getAssetSrc = (id: number) => {
  const keys = Object.keys(assetFiles)
  const match = keys.find(key => 
    key.endsWith(`/image_${id}.png`) || 
    key.endsWith(`/image_${id}.jpg`) || 
    key.endsWith(`/image_${id}.jpeg`) || 
    key.endsWith(`/image_${id}.svg`)
  )
  if (match) {
    return (assetFiles[match] as any).default.src
  }
  return ""
}

const categories = [
  {
    title: "Elite Training Facility",
    subtitle: "A professional look inside our premium heavy bag areas, training equipment lines, and custom boxing ring setup",
    ids: [2, 19, 20, 22, 23, 24, 27, 28, 29, 36, 37, 45, 51]
  },
  {
    title: "Technical Execution",
    subtitle: "High-intensity technical drills and tactical training combinations caught live on the canvas",
    ids: [17, 41]
  },
  {
    title: "Championship Honours",
    subtitle: "Celebrating our historic competitive victories, local title defenses, and international gold accolades",
    ids: [1, 16, 18, 21, 25, 30, 31, 40, 43, 44, 46, 49, 53, 56]
  },
  {
    title: "Our Historical Legacy",
    subtitle: "Decades of continuous martial arts dedication, traditional technical lineages, and community growth lines",
    ids: [38, 39, 50, 55]
  },
  {
    title: "Elite Competitors & Fighters",
    subtitle: "The certified active team members and professional fighters representing our gym layout across global promotions",
    ids: [11, 12, 13, 14, 57, 58, 59]
  }
]
---

<Layout title="Gallery | Battlefield Muay Thai Gym">
  <Header />

  <main class="flex-grow w-full max-w-7xl mx-auto px-4 py-16">
    <div class="text-center mb-16 border-b border-brandGold/20 pb-12">
      <span class="text-brandGold font-display font-bold text-sm tracking-widest uppercase block mb-2">
        Visual Showcase
      </span>
      <h1 class="text-4xl md:text-5xl font-display font-extrabold text-brandOffWhite uppercase tracking-tight">
        Training Gallery
      </h1>
      <div class="w-24 h-1 bg-brandGold mx-auto mt-6"></div>
    </div>

    {categories.map((cat) => (
      <section class="mb-20">
        <div class="mb-8 border-l-4 border-brandGold pl-4">
          <h2 class="text-2xl font-display font-extrabold text-brandGold uppercase tracking-wider">
            {cat.title}
          </h2>
          <p class="text-sm text-brandGray font-sans mt-1">
            {cat.subtitle}
          </p>
        </div>
        
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-6">
          {cat.ids.map((id) => {
            const src = getAssetSrc(id)
            if (!src) return null
            
            return (
              <button 
                class="gallery-trigger-btn group aspect-square bg-neutral-900 border border-brandGold/10 hover:border-brandGold rounded overflow-hidden relative shadow-lg focus:outline-none transition-all duration-300 animate-fade-in"
                data-src={src}
                data-alt={`${cat.title} media specimen`}
              >
                <img 
                  src={src} 
                  alt={`${cat.title} media specimen`}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover object-top group-hover:scale-105 transition-all duration-500"
                />
                <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                  <span class="text-brandGold font-display font-bold text-xs uppercase tracking-widest border border-brandGold/40 px-4 py-2 bg-black/80 rounded shadow-md">
                    Enlarge View
                  </span>
                </div>
              </button>
            )
          })}
        </div>
      </section>
    ))}
  </main>

  <div 
    id="gallery-lightbox" 
    class="hidden fixed inset-0 z-50 overflow-y-auto p-4 bg-black/95 backdrop-blur-md flex justify-center items-center select-none transition-all duration-300"
    role="dialog"
    aria-label="Image Lightbox Viewer"
  >
    <button 
      id="lightbox-close" 
      class="absolute top-6 right-6 text-brandGray hover:text-brandGold text-2xl font-sans focus:outline-none z-20 w-12 h-12 flex items-center justify-center bg-black/60 rounded-full border border-neutral-800 transition-colors duration-200" 
      aria-label="Close Lightbox"
    >
      ✕
    </button>
    <div class="max-w-5xl w-full relative max-h-[85vh] flex items-center justify-center p-2">
      <img 
        id="lightbox-img" 
        src="" 
        alt="" 
        class="max-w-full max-h-[85vh] object-contain rounded shadow-2xl border border-brandGold/20" 
      />
    </div>
  </div>
</Layout>

<script>
  const lightbox = document.getElementById("gallery-lightbox")
  const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement
  const lightboxClose = document.getElementById("lightbox-close")
  const triggerButtons = document.querySelectorAll(".gallery-trigger-btn")

  if (lightbox && lightboxImg && lightboxClose) {
    triggerButtons.forEach(button => {
      button.addEventListener("click", () => {
        const src = button.getAttribute("data-src") || ""
        const alt = button.getAttribute("data-alt") || ""

        lightboxImg.src = src
        lightboxImg.alt = alt

        lightbox.classList.remove("hidden")
        document.body.classList.add("overflow-hidden")
      })
    })

    const closeOverlay = () => {
      lightbox.classList.add("hidden")
      document.body.classList.remove("overflow-hidden")
      lightboxImg.src = ""
    }

    lightboxClose.addEventListener("click", closeOverlay)
    
    lightbox.addEventListener("click", (event) => {
      if (event.target === lightbox || event.target === lightbox.firstElementChild) {
        closeOverlay()
      }
    })

    window.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !lightbox.classList.contains("hidden")) {
        closeOverlay()
      }
    })
  }
</script>
