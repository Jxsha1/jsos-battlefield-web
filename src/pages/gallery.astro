---

<Layout title="Gallery | Battlefield Muay Thai Gym">
  <Header />

  <main class="flex-grow w-full max-w-7xl mx-auto px-4 py-16">
    <div class="text-center mb-16 border-b border-brandGold/20 pb-12">
      <span class="text-brandGold font-display font-bold text-sm tracking-widest uppercase block mb-2">
        Visual Showcase
      </span>
      <h1 class="text-4xl md:text-5xl font-display font-extrabold text-brandOffWhite uppercase tracking-tight">
        Training Gallery
      </h1>
      <div class="w-24 h-1 bg-brandGold mx-auto mt-6"></div>
    </div>

    <section class="mb-20">
      <h2 class="text-2xl font-display font-extrabold text-brandGold uppercase mb-6 border-l-4 border-brandGold pl-4">
        Inside The Facility
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <img src={fac1.src} alt="Gym Facility" class="w-full h-64 object-cover rounded shadow-lg border border-brandGold/10 hover:border-brandGold transition-colors duration-300" loading="lazy" />
        <img src={fac2.src} alt="Gym Facility" class="w-full h-64 object-cover rounded shadow-lg border border-brandGold/10 hover:border-brandGold transition-colors duration-300" loading="lazy" />
        <img src={fac3.src} alt="Gym Facility" class="w-full h-64 object-cover rounded shadow-lg border border-brandGold/10 hover:border-brandGold transition-colors duration-300" loading="lazy" />
      </div>
    </section>

    <section class="mb-20">
      <h2 class="text-2xl font-display font-extrabold text-brandGold uppercase mb-6 border-l-4 border-brandGold pl-4">
        Ladies Programme
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <img src={lad1.src} alt="Ladies Training" class="w-full h-64 object-cover rounded shadow-lg border border-brandGold/10 hover:border-brandGold transition-colors duration-300" loading="lazy" />
        <img src={lad2.src} alt="Ladies Training" class="w-full h-64 object-cover rounded shadow-lg border border-brandGold/10 hover:border-brandGold transition-colors duration-300" loading="lazy" />
        <img src={lad3.src} alt="Ladies Training" class="w-full h-64 object-cover rounded shadow-lg border border-brandGold/10 hover:border-brandGold transition-colors duration-300" loading="lazy" />
      </div>
    </section>

    <section class="mb-20">
      <h2 class="text-2xl font-display font-extrabold text-brandGold uppercase mb-6 border-l-4 border-brandGold pl-4">
        Kids & Juniors
      </h2>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        <img src={kid1.src} alt="Kids Martial Arts" class="w-full h-48 md:h-56 object-cover rounded shadow-lg border border-brandGold/10 hover:border-brandGold transition-colors duration-300" loading="lazy" />
        <img src={kid2.src} alt="Kids Martial Arts" class="w-full h-48 md:h-56 object-cover rounded shadow-lg border border-brandGold/10 hover:border-brandGold transition-colors duration-300" loading="lazy" />
