          <div class="flex flex-col sm:flex-row sm:items-center justify-between p-5 bg-neutral-900/80 border-l-4 border-brandGold rounded col-span-1 md:col-span-2">
            <div>
              <span class="text-brandGold font-display font-bold text-xs tracking-wider uppercase block mb-1">Open Sparring</span>
