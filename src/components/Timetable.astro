<section id="timetable" class="w-full py-16 border-t border-brandGold/20 bg-brandBlack">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center mb-12">
      <span class="text-brandGold font-display font-bold text-xs tracking-widest uppercase block mb-2">
        Weekly Schedule
      </span>
      <h2 class="text-3xl md:text-4xl font-display font-extrabold text-brandOffWhite uppercase tracking-tight">
        Class Timetable
      </h2>
      <div class="w-24 h-1 bg-brandGold mx-auto mt-4"></div>
    </div>

    <!-- Interactive Day Tab Switcher -->
    <div class="flex flex-wrap justify-center gap-2 mb-8">
      {["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"].map((day, index) => (
        <button
          data-day-tab={day.toLowerCase()}
          class={`px-5 py-3 rounded text-xs md:text-sm font-display font-bold uppercase tracking-wider transition-all duration-200 border ${
            index === 0
              ? "bg-brandGold text-brandBlack border-brandGold"
              : "bg-neutral-900 text-brandOffWhite border-brandGold/20 hover:border-brandGold/50"
          }`}
        >
          {day}
        </button>
      ))}
    </div>

    <!-- Schedule Cards Grid -->
    <div class="relative bg-black/40 border border-brandGold/30 p-6 md:p-8 rounded-lg shadow-2xl backdrop-blur-md min-h-[350px]">
      
      <!-- Monday Schedule -->
      <div data-day-content="monday" class="space-y-4 transition-opacity duration-300">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between p-5 bg-neutral-900/80 border-l-4 border-brandGold rounded">
            <div>
              <span class="text-brandGold font-display font-bold text-xs tracking-wider uppercase block mb-1">Ages 4 to 8</span>
              <h3 class="text-lg font-display font-extrabold text-brandOffWhite uppercase">Kids Beginners Muay Thai</h3>
            </div>
            <span class="mt-2 sm:mt-0 px-4 py-1.5 bg-brandBlack border border-brandGold/20 text-brandGold text-sm font-sans font-semibold rounded-full self-start sm:self-auto">
              16:30 - 17:15
            </span>
          </div>

          <div class="flex flex-col sm:flex-row sm:items-center justify-between p-5 bg-neutral-900/80 border-l-4 border-brandGold rounded">
            <div>
              <span class="text-brandGold font-display font-bold text-xs tracking-wider uppercase block mb-1">Ages 9 to 14</span>
              <h3 class="text-lg font-display font-extrabold text-brandOffWhite uppercase">Juniors Muay Thai Class</h3>
            </div>
            <span class="mt-2 sm:mt-0 px-4 py-1.5 bg-brandBlack border border-brandGold/20 text-brandGold text-sm font-sans font-semibold rounded-full self-start sm:self-auto">
              17:30 - 18:30
            </span>
          </div>

          <div class="flex flex-col sm:flex-row sm:items-center justify-between p-5 bg-neutral-900/80 border-l-4 border-brandGold rounded">
            <div>
              <span class="text-brandGold font-display font-bold text-xs tracking-wider uppercase block mb-1">Ladies Only</span>
              <h3 class="text-lg font-display font-extrabold text-brandOffWhite uppercase">Ladies Muay Thai & Fitness</h3>
            </div>
            <span class="mt-2 sm:mt-0 px-4 py-1.5 bg-brandBlack border border-brandGold/20 text-brandGold text-sm font-sans font-semibold rounded-full self-start sm:self-auto">
              19:00 - 20:00
            </span>
          </div>
        </div>
      </div>

      <!-- Tuesday Schedule -->
