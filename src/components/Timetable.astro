</section>

<script>
  // Modern client side tab switching logic written completely without semicolons
  const dayTabs = document.querySelectorAll("[data-day-tab]")
  const dayContents = document.querySelectorAll("[data-day-content]")

  dayTabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const selectedDay = tab.getAttribute("data-day-tab")

      // Update button styles to reflect active choice
      dayTabs.forEach((btn) => {
        btn.classList.remove("bg-brandGold", "text-brandBlack", "border-brandGold")
        btn.classList.add("bg-neutral-900", "text-brandOffWhite", "border-brandGold/20")
      })
      tab.classList.remove("bg-neutral-900", "text-brandOffWhite", "border-brandGold/20")
      tab.classList.add("bg-brandGold", "text-brandBlack", "border-brandGold")

      // Toggle display block visibility matching the active day
      dayContents.forEach((content) => {
        const contentDay = content.getAttribute("data-day-content")
        if (contentDay === selectedDay) {
          content.classList.remove("hidden")
        } else {
          content.classList.add("hidden")
        }
      })
    })
  })
</script>
