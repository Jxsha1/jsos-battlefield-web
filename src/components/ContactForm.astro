---
---

<section id="contact" class="w-full py-16 border-t border-brandGold/20 bg-brandBlack">
  <div class="max-w-4xl mx-auto px-4">
    <div class="text-center mb-12">
      <span class="text-brandGold font-display font-bold text-xs tracking-widest uppercase block mb-2">
        Get In Touch
      </span>
      <h2 class="text-3xl md:text-4xl font-display font-extrabold text-brandOffWhite uppercase tracking-tight">
        Book Your Free Trial
      </h2>
      <div class="w-24 h-1 bg-brandGold mx-auto mt-4"></div>
    </div>

    <div class="bg-black/40 border border-brandGold/30 p-8 rounded-lg shadow-2xl backdrop-blur-md">
      <div id="form-success" class="hidden mb-6 p-4 bg-emerald-950/80 border border-emerald-500 rounded-lg text-center animate-fade-in">
        <h3 class="text-xl font-display font-bold text-emerald-400 uppercase mb-2">
          Submission Successful
        </h3>
        <p class="text-sm text-brandOffWhite">
          Thank you for booking your trial. We are now transferring you to connect instantly with our team.
        </p>
      </div>

      <div id="form-error" class="hidden mb-6 p-4 bg-red-950/80 border border-red-500 rounded-lg text-center animate-fade-in">
        <h3 class="text-xl font-display font-bold text-red-400 uppercase mb-2">
          An Error Occurred
        </h3>
        <p class="text-sm text-brandOffWhite" id="error-message">
          Please check your input details and try submitting the form again.
        </p>
      </div>

      <form id="trial-enquiry-form" class="space-y-6" onsubmit="return false">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label for="fullname" class="block text-xs font-display font-bold uppercase tracking-wider text-brandGold mb-2">
              Full Name
            </label>
            <input 
              type="text" 
              id="fullname" 
              name="fullname" 
              required 
              placeholder="e.g. John Doe"
              class="w-full bg-neutral-900 border border-brandGold/20 rounded px-4 py-3 text-brandOffWhite placeholder-neutral-600 focus:outline-none focus:border-brandGold transition-colors duration-200"
            />
          </div>

          <div>
            <label for="phone" class="block text-xs font-display font-bold uppercase tracking-wider text-brandGold mb-2">
              Phone Number
            </label>
            <input 
              type="tel" 
              id="phone" 
              name="phone" 
              required 
              placeholder="e.g. 07123 456 789"
              class="w-full bg-neutral-900 border border-brandGold/20 rounded px-4 py-3 text-brandOffWhite placeholder-neutral-600 focus:outline-none focus:border-brandGold transition-colors duration-200"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label for="email" class="block text-xs font-display font-bold uppercase tracking-wider text-brandGold mb-2">
              Email Address
            </label>
            <input 
              type="email" 
              id="email" 
              name="email" 
              required 
              placeholder="e.g. contact@example.co.uk"
              class="w-full bg-neutral-900 border border-brandGold/20 rounded px-4 py-3 text-brandOffWhite placeholder-neutral-600 focus:outline-none focus:border-brandGold transition-colors duration-200"
            />
          </div>

          <div>
            <label for="programme" class="block text-xs font-display font-bold uppercase tracking-wider text-brandGold mb-2">
               Training Programme
            </label>
            <div class="relative">
              <select 
                id="programme" 
                name="programme" 
                required
                class="w-full bg-neutral-900 border border-brandGold/20 rounded px-4 py-3 text-brandOffWhite focus:outline-none focus:border-brandGold transition-colors duration-200 appearance-none cursor-pointer"
              >
                <option value="" disabled selected class="text-neutral-600">Select a class...</option>
                <option value="Kids Beginners (Ages 4 to 8)" class="bg-neutral-900">Kids Beginners (Ages 4 to 8)</option>
                <option value="Juniors (Ages 9 to 14)" class="bg-neutral-900">Juniors (Ages 9 to 14)</option>
                <option value="Adult Beginners Muay Thai" class="bg-neutral-900">Adult Beginners Muay Thai</option>
                <option value="Ladies Muay Thai & Fitness" class="bg-neutral-900">Ladies Muay Thai & Fitness</option>
                <option value="Fighter Training & Sparring" class="bg-neutral-900">Fighter Training & Sparring</option>
              </select>
              <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-brandGold">
                <svg class="fill-current h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
                  <path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"/>
                </svg>
              </div>
            </div>
          </div>
        </div>

        <div>
          <label for="message" class="block text-xs font-display font-bold uppercase tracking-wider text-brandGold mb-2">
            Additional Notes or Fitness Goals
          </label>
          <textarea 
            id="message" 
            name="message" 
            rows="4" 
            placeholder="Tell us about any previous martial arts experience or conditioning goals..."
            class="w-full bg-neutral-900 border border-brandGold/20 rounded px-4 py-3 text-brandOffWhite placeholder-neutral-600 focus:outline-none focus:border-brandGold transition-colors duration-200 resize-none"
          ></textarea>
        </div>

        <div class="pt-2 border-t border-neutral-800">
          <label class="flex items-start gap-3 cursor-pointer select-none">
            <input 
              type="checkbox" 
              id="gdpr-agree" 
              name="gdpr-agree" 
              required 
              class="mt-1 accent-brandGold w-4 h-4 rounded border-brandGold/20 focus:outline-none focus:ring-1 focus:ring-brandGold"
            />
            <span class="text-xs text-brandGray leading-tight">
              I agree to JS Office Solutions securely processing this enquiry under our privacy framework on behalf of Battlefield Muay Thai Gym. Sifu Grant and Gee will contact you using the provided number.
            </span>
          </label>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
          <button 
            type="button" 
            id="whatsapp-submit-btn"
            class="w-full bg-brandGold text-brandBlack hover:bg-brandGoldDark font-display font-bold text-sm uppercase tracking-wider py-4 rounded transition-all duration-200 shadow-lg hover:shadow-brandGold/10 flex items-center justify-center gap-2"
          >
            Send through WhatsApp
          </button>
          <button 
            type="button" 
            id="text-submit-btn"
            class="w-full bg-neutral-900 hover:bg-neutral-800 border border-brandGold text-brandGold font-display font-bold text-sm uppercase tracking-wider py-4 rounded transition-all duration-200 shadow-lg flex items-center justify-center gap-2"
          >
            Send through Text
          </button>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("trial-enquiry-form") as HTMLFormElement
  const successBanner = document.getElementById("form-success")
  const errorBanner = document.getElementById("form-error")
  const whatsappBtn = document.getElementById("whatsapp-submit-btn") as HTMLButtonElement
  const textBtn = document.getElementById("text-submit-btn") as HTMLButtonElement

  if (form && successBanner && errorBanner && whatsappBtn && textBtn) {
    const processCommunicationChannel = (mode) => {
      // Trigger native browser validity verification highlights cleanly on mobile devices
      if (!form.reportValidity()) {
        return
      }

      whatsappBtn.disabled = true
      textBtn.disabled = true

      const formData = new FormData(form)
      const data = {
        fullname: formData.get("fullname"),
        phone: formData.get("phone"),
        email: formData.get("email"),
        programme: formData.get("programme"),
        message: formData.get("message")
      }

      try {
        errorBanner.classList.add("hidden")
        successBanner.classList.remove("hidden")
        successBanner.scrollIntoView({ behavior: "smooth", block: "center" })

        const rawNumber = "447562980333"
        const plainTextBody = `New Trial Booking Request\n\nFull Name: ${data.fullname}\nPhone Number: ${data.phone}\nEmail Address: ${data.email}\nSelected Programme: ${data.programme}\nNotes: ${data.message || "None provided"}`

        form.reset()

        if (mode === "whatsapp") {
          window.location.href = `https://wa.me/${rawNumber}?text=${encodeURIComponent(plainTextBody)}`
        } else if (mode === "text") {
          window.location.href = `sms:+${rawNumber}?body=${encodeURIComponent(plainTextBody)}`
        }
      } catch (error) {
        successBanner.classList.add("hidden")
        errorBanner.classList.remove("hidden")
        const errorMsgElement = document.getElementById("error-message")
        if (errorMsgElement) {
          errorMsgElement.innerText = "A transmission error occurred. Please try contacting Grant directly on 07562 980 333."
        }
      } finally {
        whatsappBtn.disabled = false
        textBtn.disabled = false
      }
    }

    whatsappBtn.addEventListener("click", () => processCommunicationChannel("whatsapp"))
    textBtn.addEventListener("click", () => processCommunicationChannel("text"))
  }
</script>
