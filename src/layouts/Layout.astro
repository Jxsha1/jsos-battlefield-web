---
interface Props {
  title: string
}

const { title } = Astro.props
---

<!DOCTYPE html>
<html lang="en-GB" class="bg-brandBlack text-brandOffWhite scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Battlefield Muay Thai Gym</title>
    <link href="[https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800&family=Inter:wght@400;600&display=swap](https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800&family=Inter:wght@400;600&display=swap)" rel="stylesheet" />
  </head>
  <body class="min-h-screen flex flex-col justify-between font-sans selection:bg-brandGold selection:text-brandBlack">
    <slot />
  </body>
</html>
